process {
    executor = 'local'
    shell = ['/usr/bin/bash', '-euo', 'pipefail']
}

executor {
    queueSize = params.queue_size ?: 8
    cpus = params.max_cpus ? (params.max_cpus as int) : Runtime.runtime.availableProcessors()
    memory = (params.max_memory && params.max_memory.toString().trim()) ? params.max_memory.toString() : null
}

cleanup = false