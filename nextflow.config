manifest {
    name = 'MK-Flu-Pipe-Nextflow'
    author = 'Jean Phellipe Marques do Nascimento / Codex migration workspace'
    homePage = 'local'
    description = 'Incremental Nextflow migration for MK Flu-Pipe'
    version = '0.1.2'
    nextflowVersion = '>=23.10.0'
}

params {
    input_dir = null
    output_dir = "${projectDir}/results"
    irma_module = null
    seq_type = 'auto'
    seq_mode = ''

    run_fastqc = true
    host_depletion = false
    run_ivar = false
    run_medaka = false
    run_antiviral = true
    run_h5_virulence = true
    run_fullvarcall = false

    adapter_fasta = ''
    min_len_short = 75
    min_len_long = 200
    max_len_long = 0
    min_qual = 20
    filtlong_min_mean_q = null
    min_coverage = 50
    max_n_pct = 10
    min_segments = 4

    ivar_freq = 0.03
    ivar_depth = 10
    minority_freq = 0.20
    coinfection_pct = 5.0
    medaka_env = 'medaka_env'
    gisaid_location = ''
    gisaid_year = null
    metadata_csv = ''
    run_phylogeny = false
    phylogeny_context_fasta = ''
    phylogeny_context_metadata = ''
    phylogeny_min_sequences = 3
    phylogeny_threads = 4

    run_legacy_bridge = false
    legacy_script = ''

    mk_flu_docker_image = 'mk-flu-pipe/mk_flu_tools:local'
    medaka_docker_image = 'mk-flu-pipe/medaka_tools:local'
    irma_docker_image = 'cdcgov/irma:v1.3.2'
    container_registry = 'ghcr.io/nascimento-jean'
    container_tag = 'latest'
    human_db_dir = "${System.properties['user.home']}/mk_flupipe_db/human_genome"
    human_fasta_name = 'GRCh38_no_alt.fna'
    human_index_prefix = 'GRCh38'
    human_genome_url = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz'
    blast_db_dir = "${System.properties['user.home']}/mk_flupipe_db"
    blast_db_fasta = "${params.blast_db_dir}/influenza.fna"
    blast_db_prefix = "${params.blast_db_dir}/influenza_blast_db"
    blast_db_timestamp = "${params.blast_db_dir}/.last_update"
    blast_db_url = 'https://ftp.ncbi.nih.gov/genomes/INFLUENZA/influenza.fna.gz'
    blast_db_max_days = 30
    nextclade_datasets_dir = "${params.blast_db_dir}/nextclade_datasets"
    nextclade_max_days = 30
    canonical_refs_dir = "${params.blast_db_dir}/canonical_refs"
    refseq_segments_dir = "${params.blast_db_dir}/refseq_segments"
    max_cpus = null
    max_memory = null
    queue_size = 8
    fastqc_threads = 2
    fastp_threads = 2
    host_depletion_threads = 2
    irma_threads = 4
    fastp_max_forks = 2
    fastp_timeout = 1800
    fastp_startup_timeout = 0
    host_depletion_max_forks = 2
    irma_max_forks = 2
    container_uid = 1000
    container_gid = 1000
    singularity_cache_dir = "${System.properties['user.home']}/.singularity/cache"
    mk_flu_singularity_image = "${projectDir}/containers/sif/mk_flu_tools_local.sif"
    medaka_singularity_image = "${projectDir}/containers/sif/medaka_tools_local.sif"
    irma_singularity_image = 'docker://cdcgov/irma:v1.3.2'
}

process {
    executor = 'local'
    shell = ['/usr/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    maxRetries = 1

    withName: DISCOVER_SAMPLES {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PLAN_RUN {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: VALIDATE_METADATA {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_FASTQC {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 2 : Math.max(1, Math.min(2, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('2 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_FASTQC {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_FASTP {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_FASTP {
        cpus = { def req = (params.fastp_threads ?: 2) as int; params.max_cpus == null || params.max_cpus.toString().trim() == '' ? req : Math.max(1, Math.min(req, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('4 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
        maxForks = params.fastp_max_forks as int
        errorStrategy = { task.exitStatus in [124,137,140] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    withName: PRECHECK_FILTLONG {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_FILTLONG {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 2 : Math.max(1, Math.min(2, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('2 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PREPARE_HUMAN_BOWTIE2_INDEX {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 4 : Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('8 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_BOWTIE2_HOST_DEPLETION {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_HOST_DEPLETION_BOWTIE2 {
        cpus = { def req = (params.host_depletion_threads ?: 2) as int; params.max_cpus == null || params.max_cpus.toString().trim() == '' ? req : Math.max(1, Math.min(req, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('8 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
        maxForks = params.host_depletion_max_forks as int
    }
    withName: PRECHECK_MINIMAP2_HOST_DEPLETION {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_HOST_DEPLETION_MINIMAP2 {
        cpus = { def req = (params.host_depletion_threads ?: 2) as int; params.max_cpus == null || params.max_cpus.toString().trim() == '' ? req : Math.max(1, Math.min(req, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('8 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
        maxForks = params.host_depletion_max_forks as int
    }
    withName: PRECHECK_IRMA_SHORT {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_IRMA_SHORT {
        cpus = { def req = (params.irma_threads ?: 4) as int; params.max_cpus == null || params.max_cpus.toString().trim() == '' ? req : Math.max(1, Math.min(req, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('12 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
        maxForks = params.irma_max_forks as int
    }
    withName: PRECHECK_IRMA_LONG {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_IRMA_LONG {
        cpus = { def req = (params.irma_threads ?: 4) as int; params.max_cpus == null || params.max_cpus.toString().trim() == '' ? req : Math.max(1, Math.min(req, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('12 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
        maxForks = params.irma_max_forks as int
    }
    withName: RUN_EXTRACT_SEGMENTS {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_MERGE_SEGMENTS {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_ASSEMBLY_QC {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_MERGE_ASSEMBLY_QC {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_SAMTOOLS_DEPTH {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_SAMTOOLS_DEPTH {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 2 : Math.max(1, Math.min(2, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('2 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_MERGE_DEPTH_SUMMARY {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_BLAST_TYPING {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PREPARE_INFLUENZA_BLAST_DB {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 2 : Math.max(1, Math.min(2, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('4 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_BLAST_TYPING {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 4 : Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('4 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_NEXTCLADE {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_NEXTCLADE {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 2 : Math.max(1, Math.min(2, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('4 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PREPARE_CANONICAL_REFS {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_FULLVARCALL {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PREPARE_REFSEQ_SEGMENTS {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 2 : Math.max(1, Math.min(2, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('2 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_FULLVARCALL_SAMPLE {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 4 : Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('6 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_MERGE_FULLVARCALL {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_IVAR_CANONICAL {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_IVAR_CANONICAL {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 4 : Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('4 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PREPARE_ANTIVIRAL_DB {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_ANTIVIRAL_RESISTANCE {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: PRECHECK_MEDAKA_VARIANTS {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('512 MB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_MEDAKA_VARIANTS {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 4 : Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('8 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_MEDAKA_CANONICAL {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 4 : Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('8 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_ANTIVIRAL_RESISTANCE_LONG {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_H5_VIRULENCE {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_COINFECTION {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('1 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_PHYLOGENY {
        cpus = { def req = (params.phylogeny_threads ?: 4) as int; params.max_cpus == null || params.max_cpus.toString().trim() == '' ? req : Math.max(1, Math.min(req, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('8 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_SURVEILLANCE_OUTPUTS {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 1 : Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('2 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
    withName: RUN_LEGACY_PIPELINE {
        cpus = { params.max_cpus == null || params.max_cpus.toString().trim() == '' ? 4 : Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { def req = nextflow.util.MemoryUnit.of('8 GB'); if( params.max_memory == null || params.max_memory.toString().trim() == '' ) return req; def cap = nextflow.util.MemoryUnit.of(params.max_memory.toString()); req <= cap ? req : cap }
    }
}

profiles {
    standard { includeConfig 'conf/linux.config' }
    linux { includeConfig 'conf/linux.config' }
    wsl { includeConfig 'conf/linux.config' }
    ubuntu { includeConfig 'conf/linux.config' }

    docker {
        docker.enabled = true
        docker.fixOwnership = true
        docker.runOptions = "-u \$(id -u):\$(id -g)"
        includeConfig 'conf/linux.config'
        params {
            human_db_dir = "${projectDir}/mk_flupipe_db/human_genome"
            blast_db_dir = "${projectDir}/mk_flupipe_db"
            blast_db_fasta = "${projectDir}/mk_flupipe_db/influenza.fna"
            blast_db_prefix = "${projectDir}/mk_flupipe_db/influenza_blast_db"
            blast_db_timestamp = "${projectDir}/mk_flupipe_db/.last_update"
            nextclade_datasets_dir = "${projectDir}/mk_flupipe_db/nextclade_datasets"
            canonical_refs_dir = "${projectDir}/mk_flupipe_db/canonical_refs"
            refseq_segments_dir = "${projectDir}/mk_flupipe_db/refseq_segments"
        }
        process {
            withLabel: mk_flu_tools { container = params.mk_flu_docker_image ?: 'mk-flu-pipe/mk_flu_tools:local' }
            withLabel: medaka_tools { container = params.medaka_docker_image ?: 'mk-flu-pipe/medaka_tools:local' }
            withLabel: irma_tools { container = params.irma_docker_image ?: 'cdcgov/irma:v1.3.2' }
        }
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = params.singularity_cache_dir
        singularity.runOptions = "--bind /tmp"
        singularity.pullTimeout = '60 min'
        includeConfig 'conf/linux.config'
        params {
            human_db_dir = "${projectDir}/mk_flupipe_db/human_genome"
            blast_db_dir = "${projectDir}/mk_flupipe_db"
            blast_db_fasta = "${projectDir}/mk_flupipe_db/influenza.fna"
            blast_db_prefix = "${projectDir}/mk_flupipe_db/influenza_blast_db"
            blast_db_timestamp = "${projectDir}/mk_flupipe_db/.last_update"
            nextclade_datasets_dir = "${projectDir}/mk_flupipe_db/nextclade_datasets"
            canonical_refs_dir = "${projectDir}/mk_flupipe_db/canonical_refs"
            refseq_segments_dir = "${projectDir}/mk_flupipe_db/refseq_segments"
        }
        process {
            withLabel: mk_flu_tools { container = params.mk_flu_singularity_image ?: "${projectDir}/containers/sif/mk_flu_tools_local.sif" }
            withLabel: medaka_tools { container = params.medaka_singularity_image ?: "${projectDir}/containers/sif/medaka_tools_local.sif" }
            withLabel: irma_tools { container = params.irma_singularity_image ?: 'docker://cdcgov/irma:v1.3.2' }
        }
    }

    ghcr {
        params {
            mk_flu_docker_image = "${params.container_registry}/mk-flupipe-nf-mk-flu-tools:${params.container_tag}"
            medaka_docker_image = "${params.container_registry}/mk-flupipe-nf-medaka-tools:${params.container_tag}"
            mk_flu_singularity_image = "docker://${params.container_registry}/mk-flupipe-nf-mk-flu-tools:${params.container_tag}"
            medaka_singularity_image = "docker://${params.container_registry}/mk-flupipe-nf-medaka-tools:${params.container_tag}"
        }
    }
}

timeline {
    enabled = true
    file = "${params.output_dir}/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.output_dir}/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.output_dir}/trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.output_dir}/dag.html"
    overwrite = true
}
