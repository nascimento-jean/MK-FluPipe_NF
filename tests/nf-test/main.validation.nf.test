nextflow_pipeline {

    name "MK Flu-Pipe parameter validation"
    script "main.nf"

    test("rejects missing input directory") {
        when {
            params {
                input_dir = "/tmp/mkflupipe_nf_test_missing_input"
                output_dir = "tests/output/nf-test/missing-input"
                irma_module = "FLU-utr"
                seq_type = "short"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("Input directory does not exist") }
        }
    }

    test("rejects long reads with non-minion IRMA module") {
        when {
            params {
                input_dir = "${projectDir}/tests/data/long_single"
                output_dir = "tests/output/nf-test/invalid-long-module"
                irma_module = "FLU-utr"
                seq_type = "long"
                run_antiviral = "false"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("Long-read runs require --irma_module FLU-minion") }
        }
    }

    test("rejects long-read antiviral analysis without Medaka") {
        when {
            params {
                input_dir = "${projectDir}/tests/data/long_single"
                output_dir = "tests/output/nf-test/invalid-long-antiviral"
                irma_module = "FLU-minion"
                seq_type = "long"
                run_antiviral = "true"
                run_medaka = "false"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("requires --run_medaka true") }
        }
    }

    test("rejects missing metadata CSV") {
        when {
            params {
                input_dir = "${projectDir}/tests/data/short_paired"
                output_dir = "tests/output/nf-test/invalid-metadata-path"
                irma_module = "FLU-utr"
                seq_type = "short"
                metadata_csv = "${projectDir}/tests/data/metadata/not_present.csv"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("Metadata CSV does not exist or is not a file") }
        }
    }

    test("requires metadata when phylogeny is enabled") {
        when {
            params {
                input_dir = "${projectDir}/tests/data/short_paired"
                output_dir = "tests/output/nf-test/phylogeny-without-metadata"
                irma_module = "FLU-utr"
                seq_type = "short"
                run_phylogeny = "true"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("--run_phylogeny true requires --metadata_csv") }
        }
    }
}
